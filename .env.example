# Local fallback uses SQLite and data/uploads by default.
# Compose requires a URL-safe database password generated by the operator.
# POSTGRES_PASSWORD=
# Set true behind a trusted HTTPS proxy.
SENTINEL_SECURE_COOKIE=false
SENTINEL_ALLOW_REGISTER=true
SENTINEL_MAX_UPLOAD_MIB=64
SENTINEL_MAX_UNPACKED_MIB=256
SENTINEL_MAX_ENTRIES=15000
SENTINEL_QUEUE_LIMIT=24
SENTINEL_TIMEOUT_SECONDS=90
SENTINEL_RETENTION_DAYS=30
# Optional approved and evaluated JSON model artifact.
# SENTINEL_MODEL=
# SENTINEL_MODEL_SHA256=
# SENTINEL_INDICATORS=
# SENTINEL_INDICATORS_SHA256=
